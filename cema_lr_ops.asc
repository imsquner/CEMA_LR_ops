#include <torch/extension.h>    
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

constexpr uint32_t BUFFER_NUM = 2;  //tensor num for each queue

/* ----------------------------------------------------------------------
 * LRDecode 性能优化版：多核 + Level 2 向量化。
 * 规避 2201 mask 坑的策略：
 *   - vec kernel 只处理 8 的倍数部分（totalLength = N & ~7），每核分块
 *     offset 为 8 的倍数（32B 对齐），块内 count 恒为 8 的倍数 → Level 2
 *     安全，不触发尾部 mask。
 *   - tail kernel（单核标量）单独处理剩余 N%8 个元素。
 *   两个 kernel 分两次启动、写不同 GM 区间，不混用 TQue 与 GM 标量。
 * ---------------------------------------------------------------------- */
constexpr uint32_t LR_TILE = 2048;

class KernelLRDecodeVec {
public:
    __aicore__ inline KernelLRDecodeVec() {}
    __aicore__ inline void Init(GM_ADDR r, GM_ADDR a, GM_ADDR o, uint32_t totalLength, uint32_t blockLength, float mu, float sigma)
    {
        this->totalLength = totalLength;
        this->blockLength = blockLength;
        this->mu = mu;
        this->sigma = sigma;
        rGm.SetGlobalBuffer((__gm__ float*)r, totalLength);
        aGm.SetGlobalBuffer((__gm__ float*)a, totalLength);
        oGm.SetGlobalBuffer((__gm__ float*)o, totalLength);
        pipe.InitBuffer(inR, BUFFER_NUM, LR_TILE * sizeof(float));
        pipe.InitBuffer(inA, BUFFER_NUM, LR_TILE * sizeof(float));
        pipe.InitBuffer(outO, BUFFER_NUM, LR_TILE * sizeof(float));
    }
    __aicore__ inline void Process()
    {
        uint32_t base = AscendC::GetBlockIdx() * this->blockLength;
        if (base >= this->totalLength) {
            return;
        }
        uint32_t len = (this->blockLength < (this->totalLength - base)) ? this->blockLength : (this->totalLength - base);
        uint32_t off = 0;
        while (off < len) {
            uint32_t count = ((len - off) < LR_TILE) ? (len - off) : LR_TILE;
            CopyIn(base + off, count);
            Compute(count);
            CopyOut(base + off, count);
            off += count;
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> rl = inR.AllocTensor<float>();
        AscendC::LocalTensor<float> al = inA.AllocTensor<float>();
        AscendC::DataCopy(rl, rGm[offset], count);
        AscendC::DataCopy(al, aGm[offset], count);
        inR.EnQue(rl);
        inA.EnQue(al);
    }
    __aicore__ inline void Compute(uint32_t count)
    {
        AscendC::LocalTensor<float> rl = inR.DeQue<float>();
        AscendC::LocalTensor<float> al = inA.DeQue<float>();
        AscendC::LocalTensor<float> ol = outO.AllocTensor<float>();
        AscendC::Muls(ol, rl, this->sigma, count);   // ol = r * sigma
        AscendC::Adds(ol, ol, this->mu, count);      // ol = r*sigma + mu
        AscendC::Add(ol, ol, al, count);             // ol = r*sigma + mu + anchor
        outO.EnQue<float>(ol);
        inR.FreeTensor(rl);
        inA.FreeTensor(al);
    }
    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> ol = outO.DeQue<float>();
        AscendC::DataCopy(oGm[offset], ol, count);
        outO.FreeTensor(ol);
    }

    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, BUFFER_NUM> inR, inA;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outO;
    AscendC::GlobalTensor<float> rGm, aGm, oGm;
    uint32_t totalLength, blockLength;
    float mu, sigma;
};

class KernelLRDecodeTail {
public:
    __aicore__ inline KernelLRDecodeTail() {}
    __aicore__ inline void Init(GM_ADDR r, GM_ADDR a, GM_ADDR o, uint32_t offset, uint32_t count, float mu, float sigma)
    {
        this->offset = offset;
        this->count = count;
        this->mu = mu;
        this->sigma = sigma;
        rGm.SetGlobalBuffer((__gm__ float*)r, offset + count);
        aGm.SetGlobalBuffer((__gm__ float*)a, offset + count);
        oGm.SetGlobalBuffer((__gm__ float*)o, offset + count);
    }
    __aicore__ inline void Process()
    {
        for (uint32_t i = 0; i < this->count; i++) {
            uint32_t idx = this->offset + i;
            float r = this->rGm.GetValue(idx);
            float a = this->aGm.GetValue(idx);
            this->oGm.SetValue(idx, r * this->sigma + this->mu + a);
        }
    }

private:
    AscendC::GlobalTensor<float> rGm, aGm, oGm;
    uint32_t offset, count;
    float mu, sigma;
};

__global__ __vector__ void lr_decode_vec_kernel(GM_ADDR r, GM_ADDR a, GM_ADDR o, uint32_t totalLength, uint32_t blockLength, float mu, float sigma)
{
    KernelLRDecodeVec op;
    op.Init(r, a, o, totalLength, blockLength, mu, sigma);
    op.Process();
}

__global__ __vector__ void lr_decode_tail_kernel(GM_ADDR r, GM_ADDR a, GM_ADDR o, uint32_t offset, uint32_t count, float mu, float sigma)
{
    KernelLRDecodeTail op;
    op.Init(r, a, o, offset, count, mu, sigma);
    op.Process();
}

/* ======================================================================
 * 算子二：LREncode —— 差分 + 标准化（训练标签 / 数据预处理）
 *   d_t = E_t - E_{t-1}；r_t = (d_t - mu) / sigma；首点差分未定义 → 0
 * 2201 上 ShiftRight 不可用（NOT_SUPPORT），用 GM 标量访问做差分，可靠且
 * 无 32B 对齐 / UB 限制。数据量小（[B,T] 多为 12~1156），标量足够。
 * ====================================================================== */
class KernelLREncode {
public:
    __aicore__ inline KernelLREncode() {}
    __aicore__ inline void Init(GM_ADDR e, GM_ADDR o, uint32_t batch, uint32_t seqLen, float mu, float sigma)
    {
        this->batch = batch;
        this->seqLen = seqLen;
        this->mu = mu;
        this->sigma = sigma;
        eGm.SetGlobalBuffer((__gm__ float*)e, batch * seqLen);
        oGm.SetGlobalBuffer((__gm__ float*)o, batch * seqLen);
    }
    __aicore__ inline void Process()
    {
        for (uint32_t b = 0; b < this->batch; b++) {
            uint32_t base = b * this->seqLen;
            float prev = 0.0f;
            for (uint32_t t = 0; t < this->seqLen; t++) {
                float e = this->eGm.GetValue(base + t);
                float r;
                if (t == 0) {
                    r = 0.0f;                       // 首点差分未定义
                } else {
                    r = ((e - prev) - this->mu) / this->sigma;
                }
                this->oGm.SetValue(base + t, r);
                prev = e;
            }
        }
    }

private:
    AscendC::GlobalTensor<float> eGm, oGm;
    uint32_t batch, seqLen;
    float mu, sigma;
};

__global__ __vector__ void lr_encode_kernel(GM_ADDR e, GM_ADDR o, uint32_t batch, uint32_t seqLen, float mu, float sigma)
{
    KernelLREncode op;
    op.Init(e, o, batch, seqLen, mu, sigma);
    op.Process();
}

/* ======================================================================
 * 算子三：CemaFilter —— 因果 EMA 滤波（EMA9 目标/锚点 + DEMA5 输入特征）
 *   EMA9:   E9_t = 0.2 V_t + 0.8 E9_{t-1},   E9_0 = V_0
 *   EMA5:   E5_t = (1/3) V_t + (2/3) E5_{t-1}
 *   DEMA5:  D5_t = 2 EMA5_t - EMA5^(2)_t   （对 EMA5 再做一次 EMA5）
 * 递归因果扫描 → GM 标量递推（可靠；warmup 由 Host 侧掩码处理）。
 * tmpGm 为 Host 侧分配的临时缓冲，用于存放第一层 EMA5（供第二层使用）。
 * ====================================================================== */
class KernelCemaFilter {
public:
    __aicore__ inline KernelCemaFilter() {}
    __aicore__ inline void Init(GM_ADDR raw, GM_ADDR ema9, GM_ADDR dema5, GM_ADDR tmp, uint32_t batch, uint32_t seqLen)
    {
        this->batch = batch;
        this->seqLen = seqLen;
        rawGm.SetGlobalBuffer((__gm__ float*)raw, batch * seqLen);
        e9Gm.SetGlobalBuffer((__gm__ float*)ema9, batch * seqLen);
        d5Gm.SetGlobalBuffer((__gm__ float*)dema5, batch * seqLen);
        tmpGm.SetGlobalBuffer((__gm__ float*)tmp, batch * seqLen);
    }
    __aicore__ inline void Process()
    {
        const float alpha9 = 2.0f / (9.0f + 1.0f);    // 0.2
        const float alpha5 = 2.0f / (5.0f + 1.0f);    // 1/3
        const float k9 = 1.0f - alpha9;
        const float k5 = 1.0f - alpha5;
        for (uint32_t b = 0; b < this->batch; b++) {
            uint32_t base = b * this->seqLen;
            // 第一遍：EMA9 写 e9Gm；EMA5 写 tmpGm
            float v0 = this->rawGm.GetValue(base);
            float e9 = v0;
            float e5 = v0;
            this->e9Gm.SetValue(base, e9);
            this->tmpGm.SetValue(base, e5);
            for (uint32_t t = 1; t < this->seqLen; t++) {
                float v = this->rawGm.GetValue(base + t);
                e9 = alpha9 * v + k9 * e9;
                e5 = alpha5 * v + k5 * e5;
                this->e9Gm.SetValue(base + t, e9);
                this->tmpGm.SetValue(base + t, e5);
            }
            // 第二遍：对 EMA5 再做 EMA5 → DEMA5 = 2*EMA5 - EMA5^(2)
            float e5sq = this->tmpGm.GetValue(base);
            this->d5Gm.SetValue(base, 2.0f * e5sq - e5sq);
            for (uint32_t t = 1; t < this->seqLen; t++) {
                float e5cur = this->tmpGm.GetValue(base + t);
                e5sq = alpha5 * e5cur + k5 * e5sq;
                this->d5Gm.SetValue(base + t, 2.0f * e5cur - e5sq);
            }
        }
    }

private:
    AscendC::GlobalTensor<float> rawGm, e9Gm, d5Gm, tmpGm;
    uint32_t batch, seqLen;
};

__global__ __vector__ void cema_filter_kernel(GM_ADDR raw, GM_ADDR ema9, GM_ADDR dema5, GM_ADDR tmp, uint32_t batch, uint32_t seqLen)
{
    KernelCemaFilter op;
    op.Init(raw, ema9, dema5, tmp, batch, seqLen);
    op.Process();
}

/* ======================================================================
 * torch 绑定（direct invocation）
 * ====================================================================== */
namespace ascendc_ops {

/* LRDecode：多核向量化（8 倍数部分）+ 独立标量尾部 */
at::Tensor lr_decode_fast(const at::Tensor& r, const at::Tensor& anchor, double mu, double sigma)
{
    TORCH_CHECK(r.scalar_type() == at::kFloat && anchor.scalar_type() == at::kFloat, "lr_decode_fast: fp32 required");
    TORCH_CHECK(r.is_contiguous() && anchor.is_contiguous(), "lr_decode_fast: contiguous required");
    TORCH_CHECK(r.numel() == anchor.numel(), "lr_decode_fast: shape mismatch");
    auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor out = at::empty_like(r);
    uint32_t total = static_cast<uint32_t>(r.numel());
    uint32_t nvec = total & ~7u;
    uint32_t tail = total - nvec;
    constexpr uint32_t BLOCK_DIM = 8;
    if (nvec > 0) {
        uint32_t perBlock = ((nvec + BLOCK_DIM * 8 - 1) / (BLOCK_DIM * 8)) * 8;  // 8 的倍数，32B 对齐
        lr_decode_vec_kernel<<<BLOCK_DIM, nullptr, acl_stream>>>(
            (uint8_t*)(r.mutable_data_ptr()), (uint8_t*)(anchor.mutable_data_ptr()),
            (uint8_t*)(out.mutable_data_ptr()), nvec, perBlock, (float)mu, (float)sigma);
    }
    if (tail > 0) {
        lr_decode_tail_kernel<<<1, nullptr, acl_stream>>>(
            (uint8_t*)(r.mutable_data_ptr()), (uint8_t*)(anchor.mutable_data_ptr()),
            (uint8_t*)(out.mutable_data_ptr()), nvec, tail, (float)mu, (float)sigma);
    }
    return out;
}

at::Tensor lr_encode(const at::Tensor& e, double mu, double sigma)
{
    TORCH_CHECK(e.scalar_type() == at::kFloat, "lr_encode: fp32 required");
    TORCH_CHECK(e.is_contiguous(), "lr_encode: contiguous required");
    auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor out = at::empty_like(e);
    uint32_t batch = (e.dim() > 1) ? static_cast<uint32_t>(e.size(0)) : 1;
    uint32_t seqLen = static_cast<uint32_t>(e.numel() / batch);
    lr_encode_kernel<<<1, nullptr, acl_stream>>>(
        (uint8_t*)(e.mutable_data_ptr()), (uint8_t*)(out.mutable_data_ptr()),
        batch, seqLen, (float)mu, (float)sigma);
    return out;
}

std::tuple<at::Tensor, at::Tensor> cema_filter(const at::Tensor& raw)
{
    TORCH_CHECK(raw.scalar_type() == at::kFloat, "cema_filter: fp32 required");
    TORCH_CHECK(raw.is_contiguous(), "cema_filter: contiguous required");
    auto acl_stream = c10_npu::getCurrentNPUStream().stream(false);
    at::Tensor ema9 = at::empty_like(raw);
    at::Tensor dema5 = at::empty_like(raw);
    at::Tensor tmp = at::empty_like(raw);
    uint32_t batch = (raw.dim() > 1) ? static_cast<uint32_t>(raw.size(0)) : 1;
    uint32_t seqLen = static_cast<uint32_t>(raw.numel() / batch);
    cema_filter_kernel<<<1, nullptr, acl_stream>>>(
        (uint8_t*)(raw.mutable_data_ptr()), (uint8_t*)(ema9.mutable_data_ptr()),
        (uint8_t*)(dema5.mutable_data_ptr()), (uint8_t*)(tmp.mutable_data_ptr()),
        batch, seqLen);
    return {ema9, dema5};
}

} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m)
{
    m.def("lr_decode_fast(Tensor r, Tensor anchor, float mu, float sigma) -> Tensor");
    m.def("lr_encode(Tensor e, float mu, float sigma) -> Tensor");
    m.def("cema_filter(Tensor raw) -> (Tensor, Tensor)");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m)
{
    m.impl("lr_decode_fast", TORCH_FN(ascendc_ops::lr_decode_fast));
    m.impl("lr_encode", TORCH_FN(ascendc_ops::lr_encode));
    m.impl("cema_filter", TORCH_FN(ascendc_ops::cema_filter));
}
